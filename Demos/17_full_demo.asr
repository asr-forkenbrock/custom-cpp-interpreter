print("################################")
print("Functions")

func square(x){
    return x * x
}

func cube(x){
    return x * x * x
}

print(square(9))
print(cube(4))

func factorial(n){

    if(n <= 1){
        return 1
    }
    let nn = n - 1
    return n * factorial(nn)

}

print(factorial(6))

print("################################")
print("If Statements")

let score = 87

if(score >= 90){
    print("Grade A")
}else{
    if(score >= 80){
        print("Grade B")
    }else{
        print("Below B")
    }
}

print("################################")
print("Loop Demo")

let count = 0

while(count < 10){

    let count = count + 1

    if(count == 3){
        continue
    }

    if(count == 8){
        break
    }

    print(count)

}

